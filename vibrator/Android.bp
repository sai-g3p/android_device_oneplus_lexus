cc_binary {
    name: "vendor.qti.hardware.vibrator.service.lexus",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["vendor.qti.hardware.vibrator.service.lexus.rc"],
    vintf_fragments: ["vendor.qti.hardware.vibrator.service.lexus.xml"],
    cflags: ["-Wall"],
    srcs: [
        "service.cpp",
        "Vibrator.cpp",
        "VibratorOffload.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libqtivibratoreffect",
        "libqtivibratoreffectoffload",
        "libutils",
        "android.hardware.vibrator-V2-ndk",
    ],
    header_libs: ["libqtivibratoreffect_headers"],
}
