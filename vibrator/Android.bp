cc_binary {
    name: "vendor.qti.hardware.vibrator.service.lexus",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["vendor.qti.hardware.vibrator.service.lexus.rc"],
    vintf_fragments: ["vendor.qti.hardware.vibrator.service.lexus.xml"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    srcs: [
        "service.cpp",
        "Vibrator.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "android.hardware.vibrator-V2-ndk",
    ],
}
